BASEERA_ENVIRONMENT=development
BASEERA_DATABASE_URL=sqlite:///./.baseera/baseera-development.db
BASEERA_ARTIFACT_ROOT=./.baseera/artifacts
BASEERA_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
BASEERA_LLM_PROVIDER=ollama
BASEERA_LLM_BASE_URL=http://127.0.0.1:11434
BASEERA_LLM_MODEL=qwen3.5:9b
BASEERA_LLM_CONTEXT_TOKENS=4096
BASEERA_LLM_THREADS=6
BASEERA_LLM_TIMEOUT_SECONDS=180
API_INTERNAL_URL=http://127.0.0.1:8100

# --- Credential encryption (required outside development) ---
# Generate with: python -m baseera.credentials
# Rotate by moving the current value into BASEERA_SECRET_KEYS_RETIRED and setting a new
# BASEERA_SECRET_KEY; stored credentials are re-encrypted the next time they are read.
BASEERA_SECRET_KEY=
BASEERA_SECRET_KEYS_RETIRED=

# --- Source connectors ---
# Exact hosts this deployment may reach, comma separated (no wildcards).
BASEERA_CONNECTOR_ALLOW_HOSTS=
# Hosts on the customer's private network that are deliberately approved. Anything not listed
# here is still rejected by the anti-SSRF check even if it appears in the allow list above.
BASEERA_CONNECTOR_PRIVATE_HOSTS=
BASEERA_CONNECTOR_POSTGRES_SSLMODE=verify-full
BASEERA_CONNECTOR_MAX_ROWS=10000
