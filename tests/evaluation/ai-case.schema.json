{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseera.local/schemas/ai-evaluation-suite.schema.json",
  "title": "BASEERA bilingual AI evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "suiteVersion", "split", "fixture", "defaults", "cases"],
  "properties": {
    "$schema": {"type": "string"},
    "suiteVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "split": {"enum": ["development", "held_out"]},
    "description": {"type": "string"},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "reportingCutoff", "timezone", "currency"],
      "properties": {
        "id": {"type": "string"},
        "tenantId": {"type": "string"},
        "reportingCutoff": {"type": "string", "format": "date"},
        "timezone": {"type": "string"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prohibitedExposures"],
      "properties": {
        "prohibitedExposures": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locale", "topic", "prompt", "actor", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^(DEV|HO)-(EN|AR)-[A-Z]+-[0-9]{3}$"},
        "locale": {"enum": ["en", "ar"]},
        "topic": {
          "enum": [
            "sales",
            "people",
            "projects",
            "operations",
            "budgets",
            "sources",
            "ambiguity",
            "insufficient_data",
            "forecasts",
            "authorization",
            "cross_module",
            "follow_up"
          ]
        },
        "prompt": {"type": "string", "minLength": 8},
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "tenantId"],
          "properties": {
            "role": {
              "enum": ["administrator", "executive", "analyst", "department_manager", "hr_specialist", "viewer"]
            },
            "tenantId": {"type": "string"},
            "departmentScope": {"type": "array", "items": {"type": "string"}},
            "protectedFieldGrants": {"type": "array", "items": {"type": "string"}}
          }
        },
        "conversationContext": {
          "type": "object",
          "additionalProperties": false,
          "required": ["priorUser", "priorAssistantResultId"],
          "properties": {
            "priorUser": {"type": "string"},
            "priorAssistantResultId": {"type": "string"},
            "inheritedFilters": {"type": "object"}
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "claimType", "toolFamilies", "evidenceReferences", "oracleKey", "requiredSignals"],
          "properties": {
            "outcome": {"enum": ["answer", "clarify", "abstain_insufficient_data", "deny", "unavailable"]},
            "claimType": {"enum": ["fact", "forecast", "recommendation", "mixed", "none"]},
            "toolFamilies": {
              "type": "array",
              "items": {
                "enum": ["metric_query", "entity_query", "catalog", "forecast", "process", "optimization", "conversation_context"]
              }
            },
            "evidenceReferences": {"type": "array", "items": {"type": "string"}},
            "oracleKey": {"type": "string", "minLength": 1},
            "tolerance": {
              "type": "object",
              "additionalProperties": false,
              "required": ["absolute", "relative"],
              "properties": {
                "absolute": {"type": "number", "minimum": 0},
                "relative": {"type": "number", "minimum": 0}
              }
            },
            "clarificationFields": {"type": "array", "items": {"type": "string"}},
            "requiredSignals": {"type": "array", "items": {"type": "string"}},
            "prohibitedExposures": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}

