{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseera.local/contracts/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["findingId", "claim", "evidenceIds", "classification", "assumptions", "limitations"],
  "properties": {
    "findingId": { "type": "string" },
    "claim": { "type": "string", "minLength": 1 },
    "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "classification": { "enum": ["fact", "forecast", "hypothesis", "recommendation"] },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}

